dplyr::select(
DT_SIN_PRI,
drs,
atraso,
DT_REPORT
)
name_drs <- unique(boletim$drs)
for (j in name_drs) {
inicio <- Sys.time()
cat(
"\n----------------------------------------\n",
"BASE:", i, "\n",
"DRS:", j, "\n",
"Início:", format(inicio, "%H:%M:%S"), "\n",
"----------------------------------------\n"
)
tryCatch({
if (
j == "GRANDE SÃO PAULO" |
j == "CAMPINAS" |
j == "SÃO JOSÉ DO RIO PRETO"
) {
sub_data <- dados_srag %>%
dplyr::filter(drs == j)%>%
dplyr::filter(DT_SIN_PRI >= max(DT_SIN_PRI, na.rm = TRUE) - 70)
data_corte <- max(sub_data$DT_SIN_PRI) - 3
data <- sub_data %>%
dplyr::filter(DT_SIN_PRI <= data_corte) %>%
dplyr::group_by(DT_SIN_PRI) %>%
dplyr::summarise(
confirm = n(),
.groups = "drop"
) %>%
dplyr::rename(date = DT_SIN_PRI)
mean_delay<- as.numeric(round(median(sub_data$atraso, na.rm=TRUE)))
sd_delay<- as.numeric(round(quantile(sub_data$atraso, probs = 0.75)))
max_delay<-as.numeric(round(quantile(sub_data$atraso, probs = 0.99)))
reporting_delay <- LogNormal(
mean = mean_delay,
sd = sd_delay,
max = max_delay
)
} else {
sub_data <- dados_srag %>%
dplyr::filter(drs == j)%>%
dplyr::filter(DT_SIN_PRI >= max(DT_SIN_PRI, na.rm = TRUE) - 70)
data <- sub_data %>%
dplyr::group_by(DT_SIN_PRI) %>%
dplyr::summarise(
confirm = n(),
.groups = "drop"
) %>%
dplyr::rename(date = DT_SIN_PRI)
mean_delay<- as.numeric(round(median(sub_data$atraso, na.rm=TRUE)))
sd_delay<- as.numeric(round(quantile(sub_data$atraso, probs = 0.75)))
max_delay<-as.numeric(round(quantile(sub_data$atraso, probs = 0.99)))
reporting_delay <- LogNormal(
mean = mean_delay,
sd = sd_delay,
max = max_delay
)
}
gen_time <- generation_time_opts(
Gamma(
mean = 3.2,
sd = 2.1,
max = 14
)
)
estimates <- epinow(
data = data,
generation_time = gt_opts(gen_time),
delays = delay_opts(reporting_delay),
CrIs = c(0.5, 0.95),
forecast = forecast_opts(horizon = 28),
stan = stan_opts(samples = 1000),
output = c(
"samples",
"plots",
"estimate_infections"
),
verbose = FALSE
)
now <- get_predictions(
estimates,
format = "sample"
)
DT_max <- max(
now$date,
na.rm = TRUE
)
now2 <- now %>%
dplyr::mutate(
## Data original
date_onset = date,
## Semana de referência
date_onset = DT_max -
7 * floor(
as.numeric(DT_max - date_onset) / 7
)
) %>%
dplyr::group_by(
date_onset,
sample
) %>%
dplyr::summarise(
Y = sum(predicted, na.rm = TRUE),
.groups = "drop"
) %>%
dplyr::group_by(date_onset) %>%
dplyr::summarise(
Median = stats::median(
Y,
na.rm = TRUE
),
LI = stats::quantile(
Y,
probs = 0.025,
na.rm = TRUE
),
LS = stats::quantile(
Y,
probs = 0.975,
na.rm = TRUE
),
LIb = stats::quantile(
Y,
probs = 0.25,
na.rm = TRUE
),
LSb = stats::quantile(
Y,
probs = 0.75,
na.rm = TRUE
),
.groups = "drop"
)
## ===================================================
## SALVA RESULTADO
## ===================================================
now2$base <- i
now2$DRS <- j
lista_base[[length(lista_base) + 1]] <- now2
## ===================================================
## TEMPO
## ===================================================
fim <- Sys.time()
tempos_base[[length(tempos_base) + 1]] <- data.frame(
base = as.character(i),
DRS = as.character(j),
inicio = inicio,
fim = fim,
tempo_minutos = as.numeric(
difftime(
fim,
inicio,
units = "mins"
)
),
status = "OK"
)
cat(
"\n*** DRS FINALIZADA ***\n",
"Base:", i, "\n",
"DRS:", j, "\n",
"Tempo:",
round(
as.numeric(
difftime(
fim,
inicio,
units = "mins"
)
),
2
),
"minutos\n"
)
}, error = function(e) {
## ===================================================
## SALVA ERRO
## ===================================================
fim <- Sys.time()
erros_base[[length(erros_base) + 1]] <<-
data.frame(
base = as.character(i),
DRS = as.character(j),
erro = conditionMessage(e),
stringsAsFactors = FALSE
)
tempos_base[[length(tempos_base) + 1]] <<-
data.frame(
base = as.character(i),
DRS = as.character(j),
inicio = inicio,
fim = fim,
tempo_minutos = as.numeric(
difftime(
fim,
inicio,
units = "mins"
)
),
status = "ERRO"
)
cat(
"\n*** INLA CRASHOU ***\n",
"Base:", i, "\n",
"DRS:", j, "\n",
"Erro:", conditionMessage(e), "\n",
"Continuando para a próxima DRS...\n\n"
)
})
}
## =======================================================
## RETORNA TUDO DA BASE
## =======================================================
return(
list(
dados = bind_rows(lista_base),
erros = bind_rows(erros_base),
tempos = bind_rows(tempos_base)
)
)
}
resultado <- future_lapply(
file.name,
processa_base,
future.seed = TRUE
)
library(EpiNow2)
library(dplyr)
library("dplyr")
library("ggplot2")
library("rstan")
library("posterior")
library("tidyr")
library("fitdistrplus")
temp <- list.files("bases_brutas")
file.name<-as.list(temp)
lista<-list()
erros <- list()
tempos <- list()
for (i in file.name) {
boletim<- get(load(paste0("bases_brutas/",i)))
dados_srag <- boletim %>%
mutate(DT_REPORT=pmax(DT_NOTIFIC, DT_DIGITA, na.rm=TRUE)) %>%
mutate(atraso=DT_REPORT-DT_SIN_PRI) %>%
dplyr::select(DT_SIN_PRI, drs, atraso, DT_REPORT)
name_drs<- unique(boletim$drs)
print(i)
for (j in name_drs) {
print(j)
inicio <- Sys.time()
tryCatch({ if(j=="GRANDE SÃO PAULO" | j=="CAMPINAS" |j=="SÃO JOSÉ DO RIO PRETO"){
sub_data <- dados_srag %>% filter(drs == j) %>%
dplyr::mutate(date_onset=DT_SIN_PRI,
report_date=DT_REPORT,
delay=atraso)%>%
dplyr::filter(DT_REPORT>=max(DT_REPORT-70))
data_corte<- max(sub_data$DT_SIN_PRI)-3
data<- sub_data %>%
dplyr::filter(DT_SIN_PRI<=data_corte) %>%
dplyr:: group_by(DT_SIN_PRI) %>%
dplyr::summarise(confirm=n()) %>%
dplyr::rename(date=DT_SIN_PRI) %>%
dplyr::ungroup()
mean_delay<- as.numeric(round(median(sub_data$atraso, na.rm=TRUE)))
sd_delay<- as.numeric(round(quantile(sub_data$atraso, probs = 0.75)))
max_delay<-as.numeric(round(quantile(sub_data$atraso, probs = 0.99)))
reporting_delay <- LogNormal(mean = mean_delay, sd = sd_delay, max = max_delay)
gen_time<-generation_time_opts(
Gamma(mean = 3.2, sd = 2.1, max = 14)
)
estimates <- epinow(
data = data,
generation_time = gt_opts(gen_time),
delays = delay_opts(reporting_delay),
CrIs = c(0.5, 0.95),
forecast=forecast_opts(horizon = 28),
# rt = rt_opts(prior = LogNormal(mean = 2, sd = 0.2)),
stan = stan_opts(samples = 1000),
# stan = stan_opts(method = "laplace"),
output = c("samples", "plots",  "estimate_infections"),
verbose = interactive()
)
}else{
sub_data <- dados_srag %>% filter(drs == j)
data<- sub_data %>%
dplyr:: group_by(DT_SIN_PRI) %>%
dplyr::summarise(confirm=n()) %>%
dplyr::rename(date=DT_SIN_PRI) %>%
dplyr::ungroup() %>%
dplyr::filter(date>=max(date)-70)
mean_delay<- as.numeric(round(median(sub_data$atraso, na.rm=TRUE)))
sd_delay<- as.numeric(round(quantile(sub_data$atraso, probs = 0.75)))
max_delay<-as.numeric(round(quantile(sub_data$atraso, probs = 0.99)))
reporting_delay <- LogNormal(mean = mean_delay, sd = sd_delay, max = max_delay)
gen_time<-generation_time_opts(
Gamma(mean = 3.2, sd = 2.1, max = 14)
)
estimates <- epinow(
data = data,
generation_time = gt_opts(gen_time),
delays = delay_opts(reporting_delay),
CrIs = c(0.5, 0.95),
forecast=forecast_opts(horizon = 28),
# rt = rt_opts(prior = LogNormal(mean = 2, sd = 0.2)),
stan = stan_opts(samples = 1000),
#stan = stan_opts(method = "vb"),
output = c("samples", "plots",  "estimate_infections"),
verbose = interactive()
)
}
now<-get_predictions(estimates, format = "sample")
## Data máxima do dataframe
DT_max <- max(now$date, na.rm = TRUE)
now2 <- now |>
dplyr::mutate(
## Data original
date_onset = date,
## Semana de referência:
## a última semana sempre termina em DT_max
date_onset = DT_max -
7 * floor(as.numeric(DT_max - date_onset) / 7)
) %>%
group_by(date_onset) %>%
dplyr::group_by(date_onset, sample) |>
dplyr::summarise(Y = sum(predicted, na.rm = T)) |>
dplyr::group_by(date_onset) |>
dplyr::summarise(Median = stats::median(Y, na.rm = T),
LI = stats::quantile(Y, probs = 0.025, na.rm = T),
LS = stats::quantile(Y, probs = 0.975, na.rm = T),
LIb = stats::quantile(Y, probs = 0.25, na.rm = T),
LSb = stats::quantile(Y, probs = 0.75, na.rm = T),
.groups = "drop")
lista[[length(lista) + 1]] <-  now2
fim <- Sys.time()
tempos[[length(tempos) + 1]] <- data.frame(
DRS = j,
inicio = inicio,
fim = fim,
tempo_minutos = as.numeric(difftime(fim, inicio, units = "mins")),
status = "OK"
)
cat(
"\n*** DRS FINALIZADA ***\n",
"DRS:", j, "\n",
"Tempo:", round(as.numeric(difftime(fim, inicio, units = "mins")), 2),
"minutos\n\n"
)
} , error = function(e) {
# Salva informação do erro
erros[[length(erros) + 1]] <<- data.frame(
base = as.character(i),
DRS = as.character(j),
erro = conditionMessage(e),
stringsAsFactors = FALSE
)
cat("\n*** INLA CRASHOU ***\n")
cat("Base:", i, "\n")
cat("DRS:", j, "\n")
cat("Erro:", conditionMessage(e), "\n")
cat("Continuando para a próxima DRS...\n\n")
})
}
}
