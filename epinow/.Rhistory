rm(j)
use.epiweek<-FALSE
temp <- list.files("bases_brutas")
scale_factor <- 3
prop_delay <- 0.5
options(mc.cores = 4)
plan(multisession, workers = 4)
resultados <- list()
for (i in temp) {
cat("\n====================================\n")
cat("BASE:", i, "\n")
cat("====================================\n")
boletim <- get(load(paste0("bases_brutas/", i)))
dados_srag <- boletim %>%
mutate(
DT_REPORT = pmax(DT_NOTIFIC, DT_DIGITA, na.rm = TRUE),
atraso = DT_REPORT - DT_SIN_PRI
) %>%
dplyr::select(DT_SIN_PRI, drs, atraso, DT_REPORT)%>%
filter(DT_SIN_PRI >= max(DT_SIN_PRI) - 180)
name_drs<-unique(boletim$drs)
# ----------------------------------------------------------
# Paraleliza as DRS dessa base
# ----------------------------------------------------------
res_drs <- future_lapply(
name_drs,
function(j) {
inicio <- Sys.time()
cat("Iniciando:", j, "\n")
tryCatch({
# ----------------------------------------------------
# DRS especiais
# ----------------------------------------------------
if (j %in% c(
"GRANDE SÃO PAULO",
"CAMPINAS",
"SÃO JOSÉ DO RIO PRETO"
)) {
sub_data <- dados_srag %>%
filter(drs == j) %>%
mutate(
reference_date = DT_SIN_PRI,
report_date = DT_REPORT,
delay = atraso
) %>%
dplyr::select(reference_date, delay, report_date)
data_corte <- max(sub_data$reference_date) - 3
data <- sub_data %>%
# %>%
group_by(reference_date, report_date, delay) %>%
summarise(count = n(), .groups = "drop")%>%
filter(reference_date >= max(reference_date) - 70) %>%
filter(reference_date <= data_corte)
nowcast_date <- max(data$reference_date)
target_data <- filter(
data,
reference_date <= nowcast_date
)
latest_data <- data |>
group_by(reference_date) |>
summarise(final_count = sum(count))
observed_data <- filter(
data,
report_date <= nowcast_date
)
initial_reports <- observed_data |>
group_by(reference_date) |>
summarise(initial_count = sum(count))
} else {
sub_data <- dados_srag %>%
filter(drs == j) %>%
mutate(
reference_date = DT_SIN_PRI,
report_date = DT_REPORT,
delay = atraso
) %>%
dplyr::select(reference_date, delay, report_date)
data <- sub_data %>%
# %>%
group_by(reference_date, report_date, delay) %>%
summarise(count = n(), .groups = "drop")%>%
filter(reference_date >= max(reference_date) - 70)
nowcast_date <- max(data$reference_date)
target_data <- filter(
data,
reference_date <= nowcast_date
)
latest_data <- data |>
group_by(reference_date) |>
summarise(final_count = sum(count))
observed_data <- filter(
data,
report_date <= nowcast_date
)
initial_reports <- observed_data |>
group_by(reference_date) |>
summarise(initial_count = sum(count))
}
# ----------------------------------------------------
# Delay
# ----------------------------------------------------
####Trinagulo
rep_tri_full <- as_reporting_triangle(data)
rep_tri <- truncate_to_quantile(rep_tri_full, p=0.95)
if (ncol(rep_tri) > 65) {
rep_tri <- truncate_to_delay(rep_tri, max_delay = 60)
}
help("truncate_to_quantile")
# ----------------------------------------------------
# baselinenowcast
# ----------------------------------------------------
now <- baselinenowcast(
rep_tri,
scale_factor = scale_factor,
prop_delay = prop_delay,
draws = 1000
)
DT_max <- max(now$reference_date, na.rm = TRUE)
DT_max_diadasemana <- as.integer(format(DT_max, "%w"))
use.epiweek <- FALSE
obs <- initial_reports %>%
mutate(
DT.sun.aux = as.integer(format(reference_date, "%w")),
dt.aux = reference_date -
DT.sun.aux +
ifelse(
use.epiweek,
0,
DT_max_diadasemana + 1 -
ifelse(DT_max_diadasemana + 1 > DT.sun.aux, 7, 0)
),
date_onset = dt.aux -
ifelse(reference_date < dt.aux, 7, 0)
) %>%
group_by(date_onset) %>%
summarise(obs_count=sum(initial_count, na.rm = TRUE))
now2 <- now %>%
left_join(initial_reports, by = "reference_date") %>%
mutate(
DT.sun.aux = as.integer(format(reference_date, "%w")),
dt.aux = reference_date -
DT.sun.aux +
ifelse(
use.epiweek,
0,
DT_max_diadasemana + 1 -
ifelse(DT_max_diadasemana + 1 > DT.sun.aux, 7, 0)
),
date_onset = dt.aux -
ifelse(reference_date < dt.aux, 7, 0)
) %>%
group_by(date_onset, draw) %>%
summarise(
Y = sum(pred_count, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(date_onset) %>%
summarise(
Median = median(Y, na.rm = TRUE),
LI = quantile(Y, 0.025, na.rm = TRUE),
LS = quantile(Y, 0.975, na.rm = TRUE),
LIb = quantile(Y, 0.25, na.rm = TRUE),
LSb = quantile(Y, 0.75, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
base = as.character(i),
DRS = as.character(j)
) %>%
left_join(obs, by="date_onset")
fim <- Sys.time()
tempo <- data.frame(
base = i,
DRS = j,
inicio = inicio,
fim = fim,
tempo_minutos = as.numeric(
difftime(fim, inicio, units = "mins")
),
status = "OK"
)
cat(
