erro = NULL
)
}, error = function(e) {
fim <- Sys.time()
erro <- data.frame(
base = as.character(i),
DRS = as.character(j),
erro = conditionMessage(e),
stringsAsFactors = FALSE
)
tempo <- data.frame(
